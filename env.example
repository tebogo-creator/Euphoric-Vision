# Euphoric Vision, Stage 3 settings.
# On Vercel: Project > Settings > Environment Variables. Never put these in browser code or in git.
# For local testing with `vercel dev`, copy this file to ".env.local" (ignored by git).

# Your secret OpenAI key (starts with "sk-"). Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# A password you invent. The app asks for it before generating, so strangers
# who find your web address can't spend your OpenAI credit.
APP_ACCESS_CODE=

# Optional. Defaults to gpt-image-2.5-sunburst.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
